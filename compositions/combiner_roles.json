{
  "schema_version": "1.1",
  "metadata": {
    "id": "testing-combiner-roles",
    "caption": "Two sources combined under named roles"
  },
  "components": [
    { "id": "first",
      "info": { "component_info_id": "hydrocouple.components.signal_source" },
      "arguments": {
        "waveform": { "values": ["constant"] },
        "offset": { "values": [2.0] },
        "steps": { "values": [2] }
      } },
    { "id": "second",
      "info": { "component_info_id": "hydrocouple.components.signal_source" },
      "arguments": {
        "waveform": { "values": ["constant"] },
        "offset": { "values": [3.0] },
        "steps": { "values": [2] }
      } },
    { "id": "combiner",
      "info": { "component_info_id": "hydrocouple.components.combiner" },
      "arguments": { "operation": { "values": ["sum"] } } },
    { "id": "sink",
      "info": { "component_info_id": "hydrocouple.components.recorder" },
      "arguments": { "path": { "values": ["recorded_combined.csv"] } } }
  ],
  "connections": [
    { "from": { "component": "first", "output": "signal" },
      "to": { "component": "combiner", "input": "operands",
              "role": "augend" } },
    { "from": { "component": "second", "output": "signal" },
      "to": { "component": "combiner", "input": "operands",
              "role": "addend" } },
    { "from": { "component": "combiner", "output": "combined" },
      "to": { "component": "sink", "input": "in" } }
  ],
  "workflow": { "strategy": "time_stepped" }
}
